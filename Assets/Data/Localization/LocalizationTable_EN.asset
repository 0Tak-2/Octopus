  entries:
  - key: PASSIVE_NAME_BRAVE
    value: Bravery
  - key: PASSIVE_DESC_BRAVE
    value: "ATK increases the higher the enemy's HP (100%\u2192+25%)"
  - key: PASSIVE_NAME_CONFIDENCE
    value: Confidence
  - key: PASSIVE_DESC_CONFIDENCE
    value: "ATK increases proportional to your HP (100%\u2192+20%)"
  - key: PASSIVE_NAME_CRUEL
    value: Cruelty
