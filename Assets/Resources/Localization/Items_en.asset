    m_Localized: 'Raw Fish Meat

'
    m_Metadata:
      m_Items: []
  - m_Id: 16635420852224
    m_Localized: 'A remedy that stops bleeding right away when applied

'
    m_Metadata:
      m_Items: []
  - m_Id: 16636528148480
    m_Localized: 'A soothing ointment that loosens up a stiffened body

'
    m_Metadata:
      m_Items: []
  - m_Id: 16637379592192
    m_Localized: 'A soft, squishy bandage that feels nice when wrapped

'
    m_Metadata:
      m_Items: []
  - m_Id: 16638189092864
    m_Localized: 'A nicely grilled crustacean. Very filling!

'
    m_Metadata:
      m_Items: []
  - m_Id: 16638965039104
    m_Localized: 'A grilled fish with a lovely savory aroma

'
    m_Metadata:
      m_Items: []
  - m_Id: 18161346396160
    m_Localized: 'A finely sharpened sword. Feels reassuring

'
    m_Metadata:
      m_Items: []
  - m_Id: 18159551234048
    m_Localized: 'A stone shovel. Can dig through sand

'
    m_Metadata:
      m_Items: []
  - m_Id: 18157546356736
    m_Localized: 'A sturdy pickaxe made of stone

'
    m_Metadata:
      m_Items: []
  - m_Id: 18155453399040
    m_Localized: 'A cozy spot where you can rest for a while

'
    m_Metadata:
      m_Items: []
  - m_Id: 18152399945728
    m_Localized: 'A workbench where you can craft all sorts of things

'
    m_Metadata:
      m_Items: []
  - m_Id: 16664458018816
    m_Localized: 'A pickaxe made of coral. Surprisingly sturdy

'
    m_Metadata:
      m_Items: []
  - m_Id: 16662708994048
    m_Localized: 'A squishy sponge soaked full of water

'
    m_Metadata:
      m_Items: []
  - m_Id: 16661077409792
    m_Localized: 'Tough fiber pulled from seaweed. Great for tying and weaving

'
    m_Metadata:
      m_Items: []
  - m_Id: 16639657099264
    m_Localized: 'Chewy grilled squid. Looks delicious!

'
    m_Metadata:
      m_Items: []
  - m_Id: 16640365936640
    m_Localized: 'A soft, translucent jelly. Slightly tingly

'
    m_Metadata:
      m_Items: []
  - m_Id: 16640999276544
    m_Localized: 'Fresh clam meat. Probably tastier if cooked

'
    m_Metadata:
      m_Items: []
  - m_Id: 16641628422144
    m_Localized: 'Raw crustacean meat. Would be great grilled

'
    m_Metadata:
      m_Items: []
  - m_Id: 16642312093696
    m_Localized: 'Fresh fish meat. Let''s cook it up

'
    m_Metadata:
      m_Items: []
  - m_Id: 16642924462080
    m_Localized: 'Unprocessed jellyfish jelly. Looks a bit risky

'
    m_Metadata:
      m_Items: []
  - m_Id: 16643524247552
    m_Localized: 'Slimy squid meat. Best when grilled!

'
    m_Metadata:
      m_Items: []
  - m_Id: 16644182753280
    m_Localized: 'A freshly steamed clam. Your tentacles reach for it on their own

'
    m_Metadata:
      m_Items: []
  - m_Id: 16644807704576
    m_Localized: 'A curious bone that bends easily. Could craft something with this

'
    m_Metadata:
      m_Items: []
  - m_Id: 16645445238784
    m_Localized: 'A very tough scale. Perfect for armor crafting

'
    m_Metadata:
      m_Items: []
  - m_Id: 16646053412864
    m_Localized: 'A thick, sturdy shell. Would make great armor material

'
    m_Metadata:
      m_Items: []
  - m_Id: 16646682558464
    m_Localized: 'A pouch full of dark ink. Useful in many ways

'
    m_Metadata:
      m_Items: []
  - m_Id: 16647320092672
    m_Localized: 'A jellyfish tentacle that tingles when you touch it

'
    m_Metadata:
      m_Items: []
  - m_Id: 16647970209792
    m_Localized: 'Sticky mucus. Your body goes stiff if it touches you

'
    m_Metadata:
      m_Items: []
  - m_Id: 16648599355392
    m_Localized: 'A small, shimmering seahorse scale. Pretty

'
    m_Metadata:
      m_Items: []
  - m_Id: 16649228500992
    m_Localized: 'A pointy-tipped tail. Can be used for weapon crafting

'
    m_Metadata:
      m_Items: []
  - m_Id: 16649849257984
    m_Localized: 'A broken shell fragment. Collect enough and it''ll come in handy

'
    m_Metadata:
      m_Items: []
  - m_Id: 16650482597888
    m_Localized: 'A tiny bone. Can be used to make simple tools

'
    m_Metadata:
      m_Items: []
  - m_Id: 16651174658048
    m_Localized: 'A long, sharp swordfish horn. Could become a powerful weapon

'
    m_Metadata:
      m_Items: []
  - m_Id: 16651845746688
    m_Localized: 'Colorful, pretty coral. Hard enough to craft tools with

'
    m_Metadata:
      m_Items: []
  - m_Id: 16652533612544
    m_Localized: 'A plain old rock. Still useful, though

'
    m_Metadata:
      m_Items: []
  - m_Id: 16653242449920
    m_Localized: 'Fine, soft sand. Can be used as building material

'
    m_Metadata:
      m_Items: []
  - m_Id: 16653909344256
    m_Localized: 'Seaweed that sways gently in the ocean current

'
    m_Metadata:
      m_Items: []
